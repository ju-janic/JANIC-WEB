datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  STAFF
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PartnershipStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  APPROVED
  REJECTED
  CLOSED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guestRegistrations GuestRegistration[]

  @@index([email])
}

model Project {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  summary      String               @db.Text
  problem      String               @db.Text
  solution     String               @db.Text
  technology   String               @db.Text
  innovation   String?              @db.Text
  outcomes     String?              @db.Text
  category     String
  status       ContentStatus        @default(DRAFT)
  isFeatured   Boolean              @default(false)
  heroImage    String?
  demoUrl      String?
  videoUrl     String?
  githubUrl    String?
  teamMembers  String?              @db.Text
  order        Int                  @default(0)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  gallery      ProjectGalleryItem[]
  members      ProjectMember[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model ProjectGalleryItem {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  caption   String?
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TrainingProgram {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  summary       String            @db.Text
  description   String            @db.Text
  category      String
  level         String            @default("Intermediate")
  duration      String
  schedule      String
  startDate     DateTime?
  endDate       DateTime?
  mode          String            @default("On-Campus")
  certification String?
  status        ContentStatus     @default(DRAFT)
  isFeatured    Boolean           @default(false)
  coverImage    String?           @db.Text
  maxSeats      Int?
  syllabus      String?           @db.Text
  trainers      String?           @db.Text
  allowComments Boolean           @default(true)
  allowInteractions Boolean       @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  comments      TrainingComment[]
  likes         TrainingLike[]
  ratings       TrainingRating[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model TrainingComment {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  userName   String
  userAvatar String?         @db.Text
  message    String          @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@index([userId])
}

model TrainingLike {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  createdAt  DateTime        @default(now())
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model TrainingRating {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  stars      Int             @default(5)
  feedback   String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model ResearchPaper {
  id                  String            @id @default(cuid())
  title               String
  slug                String            @unique
  abstract            String            @db.Text
  content             String?           @db.Text
  authors             String            @db.Text
  authorsData         String?           @db.Text
  category            String
  publicationDate     DateTime?
  journalOrConference String?
  doi                 String?
  pdfUrl              String?           @db.Text
  status              ContentStatus     @default(DRAFT)
  isFeatured          Boolean           @default(false)
  allowComments       Boolean           @default(true)
  allowInteractions   Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  comments            ResearchComment[]
  likes               ResearchLike[]
  ratings             ResearchRating[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model ResearchComment {
  id         String        @id @default(cuid())
  paperId    String
  userId     String
  userName   String
  userAvatar String?       @db.Text
  message    String        @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  paper      ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([userId])
}

model ResearchLike {
  id        String        @id @default(cuid())
  paperId   String
  userId    String
  createdAt DateTime      @default(now())
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model ResearchRating {
  id        String        @id @default(cuid())
  paperId   String
  userId    String
  stars     Int           @default(5)
  feedback  String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model Event {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String        @db.Text
  description     String        @db.Text
  category        String
  eventDate       DateTime
  endDate         DateTime?
  location        String
  isVirtual       Boolean       @default(false)
  registrationUrl String?       @db.Text
  capacity        Int?
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  coverImage      String?       @db.Text
  videoUrl        String?       @db.Text
  attendeesCount  Int?
  gallery         String?       @db.Text
  guests          String?       @db.Text
  agenda          String?       @db.Text
  keyHighlights   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guestEventConfig GuestEventConfig?

  @@index([status, eventDate])
  @@index([category])
  @@index([slug])
}

model InnovationSubmission {
  id                   String           @id @default(cuid())
  title                String
  category             String
  description          String           @db.Text
  technologyStack      String?          @db.Text
  submitterName        String
  submitterEmail       String
  submitterPhone       String
  studentId            String?
  teamMembers          String?          @db.Text
  prototypeUrl         String?
  videoUrl             String?
  attachmentUrl        String?
  status               SubmissionStatus @default(PENDING)
  reviewNotes          String?          @db.Text
  convertedToProjectId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, createdAt])
}

model PartnershipInquiry {
  id                String   @id @default(cuid())
  organizationName  String
  organizationType  String
  contactName       String
  email             String
  phone             String?
  collaborationArea String
  proposalDetails   String   @db.Text
  logoUrl           String?  @db.VarChar(512)
  status            String   @default("NEW")
  isApproved        Boolean  @default(false)
  isRejected        Boolean  @default(false)
  adminNotes        String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

model Sponsor {
  id               String   @id @default(cuid())
  organizationName String  @db.VarChar(200)
  organizationType String?  @db.VarChar(120)
  contactName      String?  @db.VarChar(160)
  email            String?  @db.VarChar(254)
  phone            String?  @db.VarChar(40)
  website          String?  @db.VarChar(255)
  sponsorshipType  String?  @db.VarChar(120)
  whatTheySponsor String?  @db.VarChar(120)
  sponsorshipLevel String?  @db.VarChar(80)
  estimatedAmount String?  @db.VarChar(60)
  description      String?  @db.Text
  proposalUrl      String?  @db.Text
  logoUrl          String?  @db.VarChar(512)
  status           String   @default("PENDING")
  isApproved       Boolean  @default(false)
  isRejected       Boolean  @default(false)
  adminNotes      String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String        @db.Text
  status     MessageStatus @default(UNREAD)
  adminNotes String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String   @default("Faculty of Computer Science & IT")
  bio        String?  @db.Text
  avatar     String?
  email      String?
  linkedin   String?
  isFounder  Boolean  @default(false)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, order])
}

model ProjectMember {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("Team Member")
  department  String   @default("Faculty of Computer Science & IT")
  bio         String?  @db.Text
  avatar      String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  github      String?
  linkedin    String?
  twitter     String?
  instagram   String?
  facebook    String?
  website     String?
  email       String?
  phone       String?
  tags        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([isActive, order])
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  url       String
  alt       String?
  width     Int?
  height    Int?
  mimeType  String?
  sizeBytes Int?
  folder    String   @default("general")
  caption   String?  @db.Text
  source    String   @default("post")
  createdAt DateTime @default(now())
  likes     MediaLike[]
  comments  MediaComment[]
}

model MediaLike {
  id        String   @id @default(cuid())
  mediaId   String
  visitorId String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, visitorId])
  @@index([mediaId])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  name      String
  message   String   @db.Text
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
}

model OrganizationType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  visitorId String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@unique([commentId, visitorId, emoji], map: "uq_comment_visitor_emoji")
  @@index([commentId], map: "idx_commentId")
}

enum OrgType {
  FOR_PROFIT
  NONPROFIT
}

enum OrganizationCategory {
  PRIVATE_COMPANY
  STARTUP_SMALL_BUSINESS
  NGO
  COMMUNITY_BASED_ORGANIZATION
  EDUCATIONAL_INSTITUTION
  FOUNDATION_CHARITY
  YOUTH_ORGANIZATION
  OTHER
}

enum FundingStatus {
  FUNDED
  PARTIALLY_FUNDED
  SEEKING_FUNDING
  NOT_YET_DETERMINED
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ServiceCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?    @db.Text
  icon        String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  services    Service[]
  requests    ServiceRequest[] @relation("ServiceRequestCategory")

  @@index([isActive, order])
}

model Service {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  description String?         @db.Text
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[] @relation("ServiceRequestService")

  @@index([categoryId, isActive, order])
}

model ServiceRequest {
  id                        String              @id @default(cuid())
  requestNumber             String              @unique
  organizationName          String
  organizationType          OrgType
  organizationCategory      OrganizationCategory
  contactPerson             String
  email                     String
  phone                     String
  website                   String?
  country                   String
  city                      String
  address                   String?
  serviceCategoryId         String              @map("serviceCategoryId")
  serviceId                 String              @map("serviceId")
  requestTitle              String
  description               String              @db.Text
  expectedOutcomes          String?             @db.Text
  beneficiaries             String?             @db.Text
  startDate                 DateTime?
  preferredCompletionDate   DateTime?
  budget                    String?
  preferredContactMethod    String              @default("EMAIL")
  businessSector            String?
  businessOutcome           String?             @db.Text
  isExistingBusiness        Boolean?
  commercialRequirements    String?             @db.Text
  organizationMission       String?             @db.Text
  socialProblem             String?             @db.Text
  targetBeneficiaries       String?             @db.Text
  socialImpact              String?             @db.Text
  fundingStatus             FundingStatus?
  isExistingCommunityProject Boolean?
  additionalNotes           String?             @db.Text
  status                    ServiceRequestStatus @default(SUBMITTED)
  priority                  ServiceRequestPriority @default(MEDIUM)
  rejectionReason           String?             @db.Text
  submittedById             String?
  assignedToId              String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  reviewedAt                DateTime?
  completedAt               DateTime?
  serviceCategoryRef        ServiceCategory     @relation("ServiceRequestCategory", fields: [serviceCategoryId], references: [id])
  serviceRef                Service             @relation("ServiceRequestService", fields: [serviceId], references: [id])
  notes                     ServiceRequestNote[]
  attachments               ServiceRequestAttachment[]
  history                   ServiceRequestHistory[]

  @@index([status, createdAt])
  @@index([organizationType, status])
  @@index([serviceCategoryId, status])
  @@index([assignedToId, status])
  @@index([requestNumber])
}

model ServiceRequestNote {
  id         String   @id @default(cuid())
  requestId  String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ServiceRequestAttachment {
  id           String   @id @default(cuid())
  requestId    String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ServiceRequestHistory {
  id          String              @id @default(cuid())
  requestId   String
  action      String
  fromStatus  ServiceRequestStatus?
  toStatus    ServiceRequestStatus?
  actorId     String
  notes       String?             @db.Text
  createdAt   DateTime            @default(now())
  request     ServiceRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Hub {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String   @db.Text
  icon        String?
  status      String   @default("Active")
  link        String?
  tags        String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@index([slug])
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  type        String
  deadline    String
  department  String
  description String   @db.Text
  eligibility String   @db.Text
  actionUrl   String
  actionLabel String   @default("Apply Now")
  status      String   @default("Active")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model ResourceDocument {
  id          String   @id @default(cuid())
  title       String
  category    String
  format      String   @default("PDF")
  size        String   @default("500 KB")
  description String   @db.Text
  fileUrl     String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Guest Registration & Event Management
 */
/**
 * Phase 1: registration foundation. Invitation, check-in, email,
 */
/**
 * staffing and config-audit tables are created now so later phases
 */
/**
 * can attach to stable relations without destructive migrations.
 */
/**
 * ------------------------------------------------------------------
 */

enum GuestRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum GuestApprovalMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum GuestCheckInAccess {
  ADMIN_ONLY
  ADMIN_AND_CHECKIN_STAFF
  ALL_AUTHORIZED_ORGANIZERS
}

enum GuestStakeholderCategory {
  GOVERNMENT
  PRIVATE_SECTOR
  UNIVERSITY_ACADEMIC
  NGO_DEVELOPMENT
  ENTREPRENEUR_STARTUP
  PARENT_COMMUNITY
  STUDENT
  ALUMNI
  MEDIA
  VIP_GUEST
}

enum GuestAttendanceIntent {
  ATTENDING
  NOT_ATTENDING
  NOT_SURE
}

enum GuestCompanionCount {
  NONE
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
}

enum GuestReferralSource {
  UNIVERSITY_INSTITUTION
  SOCIAL_MEDIA
  EMAIL
  FRIEND_COLLEAGUE
  EVENT_ORGANIZER
  WEBSITE
  MEDIA
  OTHER
}

enum GuestStaffLevel {
  CHECKIN_STAFF
  ORGANIZER
}

enum GuestInvitationStatus {
  PENDING
  ISSUED
  REVOKED
}

enum GuestEmailType {
  REGISTRATION_RECEIVED
  APPROVAL
  REJECTION
  AUTOMATED_APPROVAL
  RESEND
}

enum GuestEmailStatus {
  PENDING
  SENT
  FAILED
}

enum GuestConfigAction {
  SAVE
  RESTORE_DEFAULTS
  MODE_CHANGE
  AUTOMATION_TOGGLE
  STAFF_GRANT
  STAFF_REVOKE
  REEVALUATE_PENDING
}

/// Operational source of truth for everything the admin can configure.
/// Event information, approval mode, eligibility rules, capacity and
/// check-in access all live here so no workflow hardcodes them.
model GuestEventConfig {
  id                   String             @id @default(cuid())
  eventId              String?            @unique
  slug                 String             @unique @db.VarChar(120)
  eventName            String
  eventDate            DateTime?
  startTime            String             @default("09:00") @db.VarChar(5)
  endTime              String             @default("17:00") @db.VarChar(5)
  timezone             String             @default("Africa/Mogadishu") @db.VarChar(64)
  venue                String?
  location             String?            @db.Text
  contactEmail         String?
  contactPhone         String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  capacity             Int?
  waitingListEnabled   Boolean            @default(true)
  approvalMode         GuestApprovalMode  @default(MANUAL)
  automationEnabled    Boolean            @default(false)
  eligibilityRules     Json?
  rulesVersion         Int                @default(1)
  checkInAccess        GuestCheckInAccess @default(ADMIN_ONLY)
  registrationPrefix   String?            @db.VarChar(40)
  guestIdPrefix        String?            @db.VarChar(40)
  version              Int                @default(1)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  event         Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registrations GuestRegistration[]
  counters      GuestCounter[]
  staff         GuestEventStaff[]
  auditLogs     GuestConfigAudit[]

  @@index([isActive])
  @@index([eventDate])
}

model GuestRegistration {
  id              String                  @id @default(cuid())
  registrationRef String                  @unique @db.VarChar(64)
  eventConfigId   String
  userId          String?
  guestId         String?                 @unique @db.VarChar(40)
  status          GuestRegistrationStatus @default(PENDING)

  // Personal information (Google Form section 1)
  fullName        String @db.VarChar(160)
  organization    String @db.VarChar(200)
  position        String @db.VarChar(160)
  email           String @db.VarChar(254)
  emailNormalized String @db.VarChar(254)
  phone           String @db.VarChar(40)
  phoneNormalized String @db.VarChar(32)

  // Stakeholder / attendance (sections 2 & 3)
  stakeholderCategory GuestStakeholderCategory
  attendanceIntent    GuestAttendanceIntent
  companionCount      GuestCompanionCount      @default(NONE)
  areasOfInterest     Json

  // Accessibility, media consent, referral & comments (sections 5-7)
  hasAccessibilityNeeds Boolean             @default(false)
  accessibilityDetails  String?             @db.Text
  mediaConsent          Boolean
  referralSource        GuestReferralSource
  additionalComments    String?             @db.Text

  // Final confirmation (section 8) + privacy consent
  accuracyConfirmed Boolean @default(true)
  privacyConsent    Boolean @default(true)

  // Snapshots of the configuration in force when the guest submitted.
  // Later phases can explain automated decisions without re-reading mutable config.
  approvalModeAtSubmit  GuestApprovalMode?
  configVersionAtSubmit Int?
  appliedRulesVersion   Int?
  eligibilityVerdict    String?            @db.VarChar(32)
  eligibilityDetails    Json?

  // Provenance & moderation preparation
  source          String    @default("web") @db.VarChar(32)
  ipAddress       String?   @db.VarChar(64)
  userAgent       String?   @db.VarChar(512)
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?   @db.Text
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  eventConfig  GuestEventConfig   @relation(fields: [eventConfigId], references: [id], onDelete: Restrict)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations  GuestInvitation[]
  checkIns     GuestCheckIn[]
  emailLogs    GuestEmailLog[]
  activityLogs GuestActivityLog[]

  @@unique([eventConfigId, emailNormalized])
  @@unique([eventConfigId, phoneNormalized])
  // One registration per signed-in user per event.
  @@unique([eventConfigId, userId])
  @@index([eventConfigId, status, submittedAt])
  @@index([status, submittedAt])
  @@index([userId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

/// Phase 2/3 preparation: issued digital invitations and their secure QR token.
model GuestInvitation {
  id               String                @id @default(cuid())
  registrationId   String                @unique
  invitationNumber String?               @unique @db.VarChar(40)
  qrToken          String                @unique @db.VarChar(128)
  status           GuestInvitationStatus @default(PENDING)
  eventSnapshot    Json?
  issuedAt         DateTime?
  revokedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  registration GuestRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Phase 2/3 preparation: one successful check-in per registration.
model GuestCheckIn {
  id             String   @id @default(cuid())
  registrationId String   @unique
  checkedInAt    DateTime @default(now())
  checkedInById  String?
  method         String   @default("QR") @db.VarChar(16)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  registration GuestRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([checkedInAt])
}

/// Phase 2 preparation: delivery audit for every guest email.
model GuestEmailLog {
  id             String           @id @default(cuid())
  registrationId String
  type           GuestEmailType
  recipient      String           @db.VarChar(254)
  status         GuestEmailStatus @default(PENDING)
  messageId      String?          @db.VarChar(191)
  error          String?          @db.Text
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  registration GuestRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
  @@index([status])
}

/// Immutable operational trail for registration and moderation events.
model GuestActivityLog {
  id             String   @id @default(cuid())
  registrationId String?
  actorId        String?
  actorLabel     String?  @db.VarChar(160)
  action         String   @db.VarChar(64)
  details        Json?
  ipAddress      String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  registration GuestRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
  @@index([action, createdAt])
}

/// Atomic sequence storage (registration references, guest IDs).
model GuestCounter {
  id            String   @id @default(cuid())
  eventConfigId String
  key           String   @db.VarChar(64)
  value         Int      @default(0)
  updatedAt     DateTime @updatedAt

  eventConfig GuestEventConfig @relation(fields: [eventConfigId], references: [id], onDelete: Cascade)

  @@unique([eventConfigId, key])
}

/// Phase 2 preparation: who may operate check-in for this event.
model GuestEventStaff {
  id            String          @id @default(cuid())
  eventConfigId String
  userId        String
  level         GuestStaffLevel
  grantedById   String?
  grantedAt     DateTime        @default(now())
  revokedById   String?
  revokedAt     DateTime?

  eventConfig GuestEventConfig @relation(fields: [eventConfigId], references: [id], onDelete: Cascade)

  @@index([eventConfigId, level, revokedAt])
  @@index([userId])
}

/// Phase 2 preparation: immutable before/after audit of admin config changes.
model GuestConfigAudit {
  id            String            @id @default(cuid())
  eventConfigId String
  actorId       String?
  actorLabel    String?           @db.VarChar(160)
  action        GuestConfigAction
  changedKeys   Json?
  before        Json?
  after         Json?
  fromVersion   Int?
  toVersion     Int?
  ipAddress     String?           @db.VarChar(64)
  userAgent     String?           @db.VarChar(512)
  createdAt     DateTime          @default(now())

  eventConfig GuestEventConfig @relation(fields: [eventConfigId], references: [id], onDelete: Cascade)

  @@index([eventConfigId, createdAt])
  @@index([actorId, createdAt])
}
